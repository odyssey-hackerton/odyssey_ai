#!/usr/bin/env bash
# 규칙에 맞지 않는 로컬 브랜치 생성·이름 변경을 차단한다. (git 2.28+)
[ "$1" = "prepared" ] || exit 0
. "$(dirname "$0")/lib/rules.sh"

status=0
while read -r old new ref; do
  case "$ref" in refs/heads/*) ;; *) continue ;; esac
  printf '%s' "$old" | grep -Eq '^0+$' || continue   # 새로 생기는 브랜치만
  printf '%s' "$new" | grep -Eq '^0+$' && continue   # 삭제는 통과
  branch="${ref#refs/heads/}"
  if ! is_valid_branch "$branch"; then
    echo "✖ 브랜치 이름이 규칙에 맞지 않아 생성을 취소했습니다: '$branch'" >&2
    print_branch_help
    status=1
  fi
done
exit $status
