#!/usr/bin/env bash
# main/dev 직접 push 차단 + 원격 브랜치 이름 검사
. "$(dirname "$0")/lib/rules.sh"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  printf '%s' "$local_sha" | grep -Eq '^0+$' && continue   # 브랜치 삭제 push는 통과
  branch="${remote_ref#refs/heads/}"

  if is_protected_branch "$branch"; then
    if [ "${ALLOW_PROTECTED_PUSH:-0}" != "1" ]; then
      echo "✖ '$branch'에는 직접 push할 수 없습니다. 작업 브랜치에서 PR을 올려주세요." >&2
      echo "  (최초 브랜치 생성 등 관리 목적일 때만: ALLOW_PROTECTED_PUSH=1 git push ...)" >&2
      status=1
    fi
    continue
  fi

  if ! is_valid_branch "$branch"; then
    echo "✖ 원격 브랜치 이름이 규칙에 맞지 않습니다: '$branch'" >&2
    print_branch_help
    status=1
  fi
done
exit $status
