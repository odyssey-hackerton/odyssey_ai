#!/usr/bin/env bash
# 커밋 메시지 header 형식 검사
. "$(dirname "$0")/lib/rules.sh"

header=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -n 1)

[ -z "$header" ] && exit 0   # 빈 메시지는 git이 알아서 중단
printf '%s\n' "$header" | grep -Eq "$COMMIT_SKIP_RE" && exit 0

fail() {
  echo "✖ 커밋 메시지 규칙 위반: $1" >&2
  echo "  입력: $header" >&2
  cat >&2 <<HELP
  형식: <type>(<scope>): <subject>
    type: ${COMMIT_TYPES//|/ }
    scope는 선택(소문자·숫자·하이픈), ': ' 뒤에 내용
  예) feat(upload): 이미지 업로드 API 추가
  자세한 내용: CONTRIBUTING.md
HELP
  exit 1
}

printf '%s\n' "$header" | grep -Eq "$COMMIT_HEADER_RE" || fail "형식이 맞지 않습니다"

len=$(char_length "$header")
[ "$len" -le "$COMMIT_HEADER_MAX" ] || fail "header가 ${COMMIT_HEADER_MAX}자를 넘습니다 (${len}자)"

case "$header" in *.) fail "header 끝에 마침표를 쓰지 않습니다" ;; esac
exit 0
