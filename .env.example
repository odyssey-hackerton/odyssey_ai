# 로컬 실행용: cp .env.example .env 후 값 채우기. .env 는 절대 커밋하지 않는다.
# GPU 서버에서는 파일 없이 docker run -e 로 넣어도 된다 (README 참고).

# 일반 서버 Redis (사설 IP). 비밀번호는 일반 서버 .env 의 REDIS_PASSWORD
REDIS_URL=redis://:비밀번호@10.1.1.27:6379/0

# AWS S3 (사진 작업에만 필요). 워커용 IAM 사용자 키: originals/* 읽기, results/* 쓰기
S3_BUCKET=odyssey-images
S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

LOG_LEVEL=INFO
