# 로컬 실행용: cp .env.example .env 후 값 채우기. .env 는 절대 커밋하지 않는다.
# GPU 서버에서는 파일 없이 docker run -e 로 넣어도 된다 (README 참고).

# 일반 서버 Redis (사설 IP). 비밀번호는 일반 서버 .env 의 REDIS_PASSWORD
REDIS_URL=redis://:비밀번호@10.1.1.27:6379/0

# AWS S3 (사진 작업에만 필요). 워커용 IAM 사용자 키: originals/* 읽기, results/* 쓰기
S3_BUCKET=odyssey-hackarton-images
S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

LOG_LEVEL=INFO

# 합성 테스트 자료 전용. 결제 연결이 없는 무료 프로젝트의 키를 사용한다.
# 백엔드 litellm/.env의 키는 자동으로 가져오지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=90

# ① 탐지 VLM 제공자. gemini(기본) | qwen (GPU 서버에서 vLLM 로 Qwen3-VL 띄운 뒤)
VLM_PROVIDER=gemini
QWEN_BASE_URL=http://localhost:8001/v1
QWEN_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ① 탐지 로컬 모델 (scripts/download-models.sh 로 준비)
DETECT_USE_VLM=true        # false 면 Gemini 없이 OCR·PII·EXIF 만
DETECT_USE_OCR=false       # true 면 PaddleOCR 로컬 OCR 추가 (모델·서버 환경 준비 후)
VEIL_DIR=models/veil
PADDLE_DEVICE=cpu          # GPU 서버: gpu:0
PADDLE_MKLDNN=false        # CPU oneDNN. std::exception 나면 false
